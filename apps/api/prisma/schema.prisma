generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_TECHNICIAN
  PHARMACIST
  ACCOUNTANT
  PATIENT
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
  TELECONSULTATION
}

enum RecordStatus {
  DRAFT
  SIGNED
  AMENDED
}

enum PrescriptionStatus {
  DRAFT
  ISSUED
  DISPENSED
  CANCELLED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  REVIEWED
  CANCELLED
}

enum LabItemStatus {
  PENDING
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  INSURANCE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  SUSPENSION
  INJECTION
  CREAM
  OINTMENT
  DROPS
  INHALER
  POWDER
  OTHER
}

enum StockMovementType {
  RECEIVED
  DISPENSED
  ADJUSTMENT
  EXPIRED
  RETURNED
}

model Hospital {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  email       String?
  phone       String?
  registrationNumber String?
  timezone    String   @default("Asia/Kolkata")
  currency    String   @default("INR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  address       Address?
  users         User[]
  departments   Department[]
  doctors       Doctor[]
  patients      Patient[]
  appointments  Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions Prescription[]
  medicines     Medicine[]
  medicineBatches MedicineBatch[]
  stockMovements StockMovement[]
  labTests      LabTest[]
  labOrders     LabOrder[]
  invoices      Invoice[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([name])
  @@index([isActive])
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  hospitalId  String?  @unique @db.Uuid
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String?
  country     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([city, country])
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  hospitalId      String?       @db.Uuid
  email           String        @unique
  phone           String?
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole
  status          AccountStatus @default(PENDING)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  hospital          Hospital?       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  doctorProfile     Doctor?
  patientProfile    Patient?
  appointmentsMade  Appointment[]   @relation("AppointmentCreatedBy")
  recordsAuthored   MedicalRecord[] @relation("RecordAuthor")
  prescriptionsAuthored Prescription[] @relation("PrescriptionAuthor")
  labOrdersCreated  LabOrder[]      @relation("LabOrderCreator")
  labOrdersReviewed LabOrder[]      @relation("LabOrderReviewer")
  invoicesCreated   Invoice[]       @relation("InvoiceCreator")
  paymentsRecorded  Payment[]       @relation("PaymentRecorder")
  notifications     Notification[]
  auditLogs         AuditLog[]
  stockMovements    StockMovement[]

  @@index([hospitalId, role])
  @@index([hospitalId, status])
  @@index([lastName, firstName])
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  hospitalId  String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital    Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  doctors     Doctor[]
  appointments Appointment[]

  @@unique([hospitalId, name])
  @@index([hospitalId, isActive])
}

model Doctor {
  id              String   @id @default(uuid()) @db.Uuid
  hospitalId      String   @db.Uuid
  userId          String   @unique @db.Uuid
  departmentId    String?  @db.Uuid
  licenseNumber   String?
  specialization  String?
  qualification   String?
  consultationFee Decimal  @default(0) @db.Decimal(12, 2)
  bio             String?
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  hospital       Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  availability   DoctorAvailability[]

  @@unique([hospitalId, licenseNumber])
  @@index([hospitalId, departmentId])
  @@index([hospitalId, specialization])
  @@index([hospitalId, isAvailable])
}

model DoctorAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  doctorId    String   @db.Uuid
  dayOfWeek   Int
  startTime   String
  endTime     String
  slotMinutes Int      @default(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek, isActive])
}

model Patient {
  id                String   @id @default(uuid()) @db.Uuid
  hospitalId        String   @db.Uuid
  userId            String?  @unique @db.Uuid
  patientNumber     String
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  gender            Gender?
  bloodGroup        String?
  email             String?
  phone             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  allergies         String?
  medicalHistory    String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  hospital       Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  invoices       Invoice[]

  @@unique([hospitalId, patientNumber])
  @@index([hospitalId, lastName, firstName])
  @@index([hospitalId, phone])
  @@index([hospitalId, createdAt])
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  hospitalId     String            @db.Uuid
  patientId      String            @db.Uuid
  doctorId       String            @db.Uuid
  departmentId   String?           @db.Uuid
  createdById    String?           @db.Uuid
  appointmentAt  DateTime
  durationMinutes Int              @default(30)
  type           AppointmentType   @default(CONSULTATION)
  status         AppointmentStatus @default(SCHEDULED)
  reason         String?
  notes          String?
  cancellationReason String?
  checkedInAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor     Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  medicalRecord MedicalRecord?

  @@index([hospitalId, appointmentAt, status])
  @@index([hospitalId, patientId, appointmentAt])
  @@index([hospitalId, doctorId, appointmentAt])
}

model MedicalRecord {
  id            String       @id @default(uuid()) @db.Uuid
  hospitalId    String       @db.Uuid
  patientId     String       @db.Uuid
  doctorId      String       @db.Uuid
  appointmentId String?      @unique @db.Uuid
  authorId      String?      @db.Uuid
  status        RecordStatus @default(DRAFT)
  chiefComplaint String?
  symptoms      String?
  diagnosis     String?
  treatmentPlan String?
  notes         String?
  temperatureC  Decimal?     @db.Decimal(5, 2)
  bloodPressureSystolic Int?
  bloodPressureDiastolic Int?
  pulseBpm      Int?
  respiratoryRate Int?
  oxygenSaturation Int?
  weightKg      Decimal?     @db.Decimal(6, 2)
  heightCm      Decimal?     @db.Decimal(6, 2)
  signedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  author       User?         @relation("RecordAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]
  labOrders    LabOrder[]

  @@index([hospitalId, patientId, createdAt])
  @@index([hospitalId, doctorId, createdAt])
  @@index([hospitalId, status])
}

model Prescription {
  id             String             @id @default(uuid()) @db.Uuid
  hospitalId     String             @db.Uuid
  patientId      String             @db.Uuid
  doctorId       String             @db.Uuid
  medicalRecordId String?            @db.Uuid
  authorId       String?             @db.Uuid
  status         PrescriptionStatus @default(DRAFT)
  instructions   String?
  issuedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  author        User?          @relation("PrescriptionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  items         PrescriptionItem[]

  @@index([hospitalId, patientId, createdAt])
  @@index([hospitalId, doctorId, status])
}

model PrescriptionItem {
  id             String      @id @default(uuid()) @db.Uuid
  prescriptionId String      @db.Uuid
  medicineId     String?     @db.Uuid
  medicineName   String
  form           MedicineForm?
  dosage         String
  frequency      String
  duration       String
  quantity       Int
  instructions   String?
  createdAt      DateTime    @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@index([medicineId])
}

model Medicine {
  id             String      @id @default(uuid()) @db.Uuid
  hospitalId     String      @db.Uuid
  name           String
  genericName    String?
  sku            String?
  form           MedicineForm @default(OTHER)
  strength       String?
  manufacturer   String?
  unit           String      @default("unit")
  reorderLevel   Int         @default(10)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  hospital           Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  batches             MedicineBatch[]
  prescriptionItems   PrescriptionItem[]
  stockMovements      StockMovement[]

  @@unique([hospitalId, sku])
  @@index([hospitalId, name])
  @@index([hospitalId, isActive])
}

model MedicineBatch {
  id            String   @id @default(uuid()) @db.Uuid
  hospitalId    String   @db.Uuid
  medicineId    String   @db.Uuid
  batchNumber   String
  quantity      Int
  purchasePrice Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  expiryDate    DateTime
  receivedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@unique([hospitalId, medicineId, batchNumber])
  @@index([hospitalId, medicineId, expiryDate])
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  hospitalId     String            @db.Uuid
  medicineId     String            @db.Uuid
  batchId        String?           @db.Uuid
  userId         String?           @db.Uuid
  type           StockMovementType
  quantity       Int
  reason         String?
  reference      String?
  createdAt      DateTime          @default(now())

  hospital Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  medicine Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch    MedicineBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hospitalId, medicineId, createdAt])
  @@index([batchId, createdAt])
}

model LabTest {
  id            String   @id @default(uuid()) @db.Uuid
  hospitalId    String   @db.Uuid
  name          String
  code          String?
  description   String?
  price         Decimal  @default(0) @db.Decimal(12, 2)
  turnaroundHours Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hospital Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  orderItems LabOrderItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId, name])
}

model LabOrder {
  id              String         @id @default(uuid()) @db.Uuid
  hospitalId      String         @db.Uuid
  patientId       String         @db.Uuid
  medicalRecordId String?        @db.Uuid
  createdById     String?        @db.Uuid
  reviewedById    String?        @db.Uuid
  status          LabOrderStatus @default(ORDERED)
  clinicalNotes   String?
  orderedAt       DateTime       @default(now())
  sampleCollectedAt DateTime?
  completedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  createdBy     User?          @relation("LabOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy    User?          @relation("LabOrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  items         LabOrderItem[]

  @@index([hospitalId, status, orderedAt])
  @@index([hospitalId, patientId, orderedAt])
}

model LabOrderItem {
  id           String        @id @default(uuid()) @db.Uuid
  labOrderId   String        @db.Uuid
  labTestId    String        @db.Uuid
  status       LabItemStatus @default(PENDING)
  result       String?
  resultUnit   String?
  referenceRange String?
  remarks      String?
  resultAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTest  LabTest  @relation(fields: [labTestId], references: [id], onDelete: Restrict)

  @@index([labOrderId, status])
  @@index([labTestId])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  hospitalId     String        @db.Uuid
  patientId      String        @db.Uuid
  createdById    String?       @db.Uuid
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  dueDate        DateTime?
  issuedAt       DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  hospital Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient  Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy User?       @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payments  Payment[]

  @@unique([hospitalId, invoiceNumber])
  @@index([hospitalId, patientId, createdAt])
  @@index([hospitalId, status, dueDate])
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  invoiceId         String        @db.Uuid
  recordedById      String?       @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  providerReference String?       @unique
  idempotencyKey    String?       @unique
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User?   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId, status])
  @@index([createdAt])
}

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  hospitalId  String?            @db.Uuid
  userId      String?            @db.Uuid
  channel     NotificationChannel @default(IN_APP)
  status      NotificationStatus  @default(PENDING)
  title       String
  message     String
  recipient   String?
  metadata    Json?
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hospitalId, status, createdAt])
  @@index([userId, status, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  hospitalId  String?  @db.Uuid
  userId      String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hospitalId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}